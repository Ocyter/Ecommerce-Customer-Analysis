// Starter measures. Create each separately in Desktop.
// SQL outputs are verified; DAX execution in Desktop is still to be checked.
Completed Orders =
CALCULATE (
    COUNTROWS ( Orders ),
    KEEPFILTERS ( Orders[order_status] = "completed" )
)

Reported Amount NGN =
CALCULATE (
    SUM ( Orders[amount_ngn] ),
    KEEPFILTERS ( Orders[order_status] = "completed" )
)

// Reconciliation is a disconnected, full-extract summary table.
Input Rows = SUM ( Reconciliation[rows] )

Quarantined Rows =
CALCULATE (
    SUM ( Reconciliation[rows] ),
    Reconciliation[disposition] = "quarantined"
)

Reported Rows =
CALCULATE (
    SUM ( Reconciliation[rows] ),
    Reconciliation[disposition] = "reported"
)

Outside Scope Rows =
CALCULATE (
    SUM ( Reconciliation[rows] ),
    Reconciliation[disposition] = "outside_reporting_scope"
)

Reconciliation Difference =
[Input Rows] - [Quarantined Rows] - [Reported Rows] - [Outside Scope Rows]
