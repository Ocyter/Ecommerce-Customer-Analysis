        ],
        "partitions": [
          {
            "name": "Customers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Csv = Csv.Document(Binary.FromText(\"Y3VzdG9tZXJfaWQscmVnaW9uCkMwMDEsTm9ydGgKQzAwMixTb3V0aApDMDA1LFdlc3QKQzAwNixOb3J0aAo=\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),",
                "    Blanks = Headers,",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"customer_id\", type text}, {\"region\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Orders",
        "columns": [
          {
            "name": "order_row",
            "dataType": "int64",
            "sourceColumn": "order_row",
            "summarizeBy": "none"
          },
          {
            "name": "order_id",
