            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "order_status",
            "dataType": "string",
            "sourceColumn": "order_status",
            "summarizeBy": "none"
          },
          {
            "name": "amount_ngn",
            "dataType": "int64",
            "sourceColumn": "amount_ngn",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Csv = Csv.Document(Binary.FromText(\"b3JkZXJfcm93LG9yZGVyX2lkLGN1c3RvbWVyX2lkLG9yZGVyX3N0YXR1cyxhbW91bnRfbmduCjEsTzAwMSxDMDAxLGNvbXBsZXRlZCwxMjAwMAo2LE8wMDUsQzAwNSxjYW5jZWxsZWQsNjAwMAo4LE8wMDcsQzAwNSxjb21wbGV0ZWQsMjQwMDAKMTEsTzAxMCxDMDA2LHBlbmRpbmcsNTAwMAoxMixPMDExLEMwMDYsY29tcGxldGVkLDE2MDAwCg==\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),",
                "    Blanks = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, {\"order_row\", \"amount_ngn\"}),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"order_row\", Int64.Type}, {\"order_id\", type text}, {\"customer_id\", type text}, {\"order_status\", type text}, {\"amount_ngn\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Completed Orders",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Orders), KEEPFILTERS(Orders[order_status] = \"completed\")), 0)",
            "formatString": "#,0;(#,0);0"
          },
          {
            "name": "Reported Amount NGN",
            "expression": "COALESCE(CALCULATE(SUM(Orders[amount_ngn]), KEEPFILTERS(Orders[order_status] = \"completed\")), 0)",
            "formatString": "#,0;(#,0);0"
          }
        ]
      },
      {
