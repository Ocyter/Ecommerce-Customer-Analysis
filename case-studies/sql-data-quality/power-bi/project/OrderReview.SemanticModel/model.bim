              "type": "m",
              "expression": [
                "let",
                "    Csv = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),",
                "    Blanks = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, {\"order_row\", \"amount_ngn\"}),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"order_row\", Int64.Type}, {\"order_id\", type text}, {\"customer_id\", type text}, {\"order_status\", type text}, {\"amount_ngn\", Int64.Type}, {\"issue\", type text}}, \"en-US\")",
