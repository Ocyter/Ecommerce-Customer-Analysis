            "sourceColumn": "rows",
            "summarizeBy": "none"
          },
          {
            "name": "known_amount_ngn",
            "dataType": "int64",
            "sourceColumn": "known_amount_ngn",
            "summarizeBy": "none"
          },
          {
            "name": "missing_amount_rows",
            "dataType": "int64",
            "sourceColumn": "missing_amount_rows",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Reconciliation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Csv = Csv.Document(Binary.FromText(\"ZGlzcG9zaXRpb24scm93cyxrbm93bl9hbW91bnRfbmduLG1pc3NpbmdfYW1vdW50X3Jvd3MKb3V0c2lkZV9yZXBvcnRpbmdfc2NvcGUsMiwxMTAwMCwwCnF1YXJhbnRpbmVkLDcsNTk1MDAsMQpyZXBvcnRlZCwzLDUyMDAwLDAK\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),",
                "    Blanks = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, {\"rows\", \"known_amount_ngn\", \"missing_amount_rows\"}),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"disposition\", type text}, {\"rows\", Int64.Type}, {\"known_amount_ngn\", Int64.Type}, {\"missing_amount_rows\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Routed Rows",
            "expression": "SUM(Reconciliation[rows])",
            "formatString": "#,0;(#,0);0"
          },
          {
            "name": "Routed Known Amount NGN",
            "expression": "SUM(Reconciliation[known_amount_ngn])",
            "formatString": "#,0;(#,0);0"
          },
          {
            "name": "Row Difference",
            "expression": "[Input Rows] - CALCULATE([Routed Rows], REMOVEFILTERS(Reconciliation))",
            "formatString": "#,0;(#,0);0"
          },
          {
            "name": "Known Amount Difference NGN",
            "expression": "[Raw Known Amount NGN] - CALCULATE([Routed Known Amount NGN], REMOVEFILTERS(Reconciliation))",
            "formatString": "#,0;(#,0);0"
          }
        ]
      },
